exports[`standalone HTML exports > emits valid self-contained HTML for the auto-layout page > auto-layout page 1`] = `
"<!DOCTYPE html>
<!-- Generated by Figma to Code | Feature page | 2026-11-21 -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Feature page</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body { margin: 0; font-family: system-ui, sans-serif; }

    img { display: block; max-width: 100%; }

    :root {
      --figma-space-1: 12px;
      --figma-color-2: rgba(38, 92, 184, 1);
    }

    .figma-feature-page {
      box-sizing: border-box;
      margin: 0;
      min-width: 0;
      width: 480px;
      max-width: 100%;
      min-height: 100px;
      position: relative;
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      padding: var(--figma-space-1, 12px) var(--figma-space-1, 12px) var(--figma-space-1, 12px) var(--figma-space-1, 12px);
      gap: var(--figma-space-1, 12px);
    }

    .figma-feature-page__article-feature-card {
      box-sizing: border-box;
      margin: 0;
      min-width: 0;
      width: 200px;
      max-width: 100%;
      min-height: 54px;
      position: relative;
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: flex-start;
      padding: 12px 16px 12px 12px;
      gap: 12px;
    }

    .figma-feature-page__feature {
      box-sizing: border-box;
      margin: 0;
      min-width: 0;
      width: 80px;
      max-width: 100%;
      min-height: 30px;
      background-color: var(--figma-color-2, rgba(38, 92, 184, 1));
    }
  </style>
</head>
<body>
    <div class="figma-feature-page">
      <article class="figma-feature-page__article-feature-card">
        <div class="figma-feature-page__feature"></div>
        <div class="figma-feature-page__feature"></div>
      </article>
    </div>
</body>
</html>
"
`;

exports[`standalone HTML exports > emits valid self-contained HTML for the overflowing frame > overflowing frame 1`] = `
"<!DOCTYPE html>
<!-- Generated by Figma to Code | Overflowing frame | 2026-11-21 -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Overflowing frame</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body { margin: 0; font-family: system-ui, sans-serif; }

    img { display: block; max-width: 100%; }

    :root {
      --figma-color-1: rgba(38, 92, 184, 1);
    }

    .figma-overflowing-frame {
      box-sizing: border-box;
      margin: 0;
      min-width: 0;
      width: 150px;
      max-width: 100%;
      min-height: 81px;
      position: relative;
    }

    .figma-overflowing-frame__protruding-tile {
      box-sizing: border-box;
      margin: 0;
      min-width: 0;
      width: 70px;
      max-width: 100%;
      min-height: 36px;
      position: absolute;
      left: 80px;
      top: 45px;
      background-color: var(--figma-color-1, rgba(38, 92, 184, 1));
    }
  </style>
</head>
<body>
    <div class="figma-overflowing-frame">
      <div class="figma-overflowing-frame__protruding-tile"></div>
    </div>
</body>
</html>
"
`;


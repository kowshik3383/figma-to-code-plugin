{
  "name": "figma-to-code-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "A Figma plugin that generates production-ready code from your designs: HTML, Tailwind, React, Svelte, and Styled Components.",
  "keywords": [
    "codegen",
    "figma",
    "figma-plugin",
    "html",
    "react",
    "svelte",
    "tailwind"
  ],
  "homepage": "https://github.com/kowshik3383/figma-to-code-plugin",
  "bugs": {
    "url": "https://github.com/kowshik3383/figma-to-code-plugin/issues"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/kowshik3383/figma-to-code-plugin.git"
  },
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo run build:watch",
    "dev": "turbo run dev --concurrency 20",
    "lint": "oxlint .",
    "test": "turbo run test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
